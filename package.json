{
  "name": "anchorfile",
  "version": "0.1.4",
  "description": "Scan a software repository and generate a CLAUDE.md context file for AI coding agents.",
  "keywords": [
    "claude",
    "ai",
    "context",
    "codegen",
    "cli"
  ],
  "homepage": "https://github.com/VelaWind/anchorfile#readme",
  "bugs": {
    "url": "https://github.com/VelaWind/anchorfile/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelaWind/anchorfile.git"
  },
  "license": "MIT",
  "author": "VelaWind <velawindhq@gmail.com>",
  "main": "dist/index.js",
  "bin": {
    "anchorfile": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
